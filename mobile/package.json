{
  "name": "@seed-bible/mobile",
  "version": "1.0.0",
  "description": "Capacitor wrapper that packages the Seed Bible web app as native iOS and Android apps.",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "pnpm --dir .. build:native",
    "sync": "pnpm build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
