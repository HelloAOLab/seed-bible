{
  "name": "seed-bible",
  "version": "1.0.0",
  "description": "The source code behind the Seed Bible.",
  "type": "module",
  "main": "server/dist/index.js",
  "scripts": {
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "dev": "bun server/index.ts",
    "build": "pnpm build:client && pnpm build:ssr && pnpm build:server && pnpm sitemap",
    "build:client": "vp build",
    "build:ssr": "vp build --ssr standalone/entry-ssr.tsx",
    "build:server": "bun build --target=bun --external express --external vite --outfile=server/dist/index.js ./server/index.ts",
    "lint": "vp lint && stylelint \"packages/**/*.css\" && tsx script/check-i18n.ts",
    "lint:fix": "vp lint --fix && stylelint \"packages/**/*.css\" --fix && tsx script/check-i18n.ts --fix",
    "check:ts": "pnpm run check:ts:client && pnpm run check:ts:sw && pnpm run check:patterns",
    "check:ts:client": "tsgo --project ./tsconfig.json",
    "check:ts:sw": "tsgo --project ./standalone/tsconfig.sw.json",
    "check:patterns": "tsgo --project ./patterns/tsconfig.json",
    "check:i18n": "tsx script/check-i18n.ts",
    "pattern": "tsx script/pattern.ts",
    "notify": "tsx script/notify.ts",
    "release:prepare": "tsx script/release.ts prepare",
    "changelog:extract": "tsx script/changelog.ts extract",
    "build-size-report": "tsx script/build-size-report.ts",
    "coverage-summary": "tsx script/coverage-summary.ts",
    "i18n": "tsx script/i18n.ts",
    "list-bible-translations": "tsx script/list-bible-translations.ts",
    "generate-book-chapter-verse-counts": "tsx script/generate-book-chapter-verse-counts.ts",
    "sitemap": "tsx script/generate-sitemap.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "vp hooks enable && tsx script/setupMergeDriver.ts",
    "preview": "tsx script/preview.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloAOLab/seed-bible.git"
  },
  "keywords": [
    "bible"
  ],
  "author": "AO Lab <hello@helloao.org>",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/HelloAOLab/seed-bible/issues"
  },
  "homepage": "https://github.com/HelloAOLab/seed-bible#readme",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.15.0",
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@casual-simulation/aux-common": "^4.2.3",
    "@casual-simulation/aux-records": "^4.2.3",
    "@casual-simulation/aux-runtime": "^4.2.3",
    "@casual-simulation/aux-vm": "^4.2.3",
    "@casual-simulation/crypto": "^4.0.5",
    "@casual-simulation/fast-json-stable-stringify": "^4.0.5",
    "@google-cloud/translate": "^9.3.0",
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.1",
    "@preact/signals-debug": "^1.4.2",
    "@testing-library/preact": "^3.2.4",
    "@tiptap/core": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^28.0.3",
    "@types/json-schema": "catalog:",
