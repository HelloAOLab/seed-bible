    "@types/prompts": "^2.4.9",
    "@typescript-eslint/utils": "^8.58.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "axios": "catalog:",
    "casualos": "4.2.4-alpha.25223847785",
    "chokidar": "^5.0.0",
    "commander": "^14.0.1",
    "conf": "^15.0.2",
    "es-toolkit": "1.39.10",
    "esbuild": "^0.25.10",
    "express": "^5.2.1",
    "hash.js": "^1.1.7",
    "html-entities": "2.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "preact": "catalog:",
    "preact-iso": "catalog:",
    "prompts": "^2.4.2",
    "puppeteer": "^24.30.0",
    "rxjs": "catalog:",
    "stylelint": "^17.14.1",
    "stylelint-plugin-use-baseline": "^1.4.6",
    "ts-morph": "^27.0.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "uuid": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "0.3.2",
    "vitest": "4.1.11",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bowser": "^2.14.1",
    "debounce": "^2.2.0",
    "get-tsconfig": "^4.13.0",
    "html2canvas": "^1.4.1",
    "i18next": "catalog:",
    "i18next-resources-to-backend": "catalog:",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^1.3.4",
    "preact-render-to-string": "catalog:",
    "prompts": "^2.4.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typesense": "catalog:",
    "zod": "catalog:"
  }
}
