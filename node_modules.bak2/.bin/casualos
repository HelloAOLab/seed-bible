else
  export NODE_PATH="/Users/kushagrakarki/Desktop/seed/seed-bible/node_modules/.pnpm/casualos@4.2.4-alpha.25223847785_@babel+runtime@7.29.2_ws@8.19.0/node_modules/casualos/node_modules:/Users/kushagrakarki/Desktop/seed/seed-bible/node_modules/.pnpm/casualos@4.2.4-alpha.25223847785_@babel+runtime@7.29.2_ws@8.19.0/node_modules:/Users/kushagrakarki/Desktop/seed/seed-bible/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../casualos/dist/cli.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../casualos/dist/cli.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../casualos/dist/cli.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../casualos/dist/cli.js" "$@"
else
  exec node  "$basedir/../casualos/dist/cli.js" "$@"
fi
