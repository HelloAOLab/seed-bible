{
  "permissions": {
    "allow": [
      "Bash(gh api repos/HelloAOLab/seed-bible/issues/*/comments -F body=@*)",
      "Bash(gh api -X PATCH repos/HelloAOLab/seed-bible/issues/comments/* -F body=@*)",
      "Bash(git push https://github.com/HelloAOLab/pr-test-plans.git HEAD:main)",
      "mcp__github__add_issue_comment",
